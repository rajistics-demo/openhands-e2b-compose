# Copy to e2b.env. Keep the populated file private.
E2B_API_KEY=
E2B_INIT_API_KEY=
E2B_TEMPLATE=
E2B_DOMAIN=e2b.app
E2B_CALLBACK_ORIGIN=https://openhands.example.com
E2B_LEASE_SECONDS=3600
# Use kill in disposable tests that must exercise VM expiry.
# E2B_TIMEOUT_ACTION=kill
E2B_SANDBOX_LIMIT=2
# Optional hot inventory for one organization and spec. Size zero disables claims and refill.
# E2B_WARM_POOL_SIZE=0
# E2B_WARM_POOL_PAUSED_SIZE=0
# E2B_WARM_POOL_ORG_ID=
# E2B_WARM_POOL_SPEC_ID=
# Isolated recovery pilot with the matching Enterprise and Canvas overlays.
# E2B_PILOT_RECOVERY_ENABLED=false
# E2B_PILOT_RECOVERY_ORG_ID=
# E2B_PILOT_PREVIEW_SHA256=
# Optional settings for docker-compose.e2b-profiles.yml.
# E2B_LARGE_TEMPLATE=
# E2B_LARGE_INIT_API_KEY=
# E2B_APPROVED_EGRESS_HOSTS='["callbacks.example.com","model.example.com"]'
