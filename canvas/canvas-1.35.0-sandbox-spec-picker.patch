diff --git a/src/api/cloud/sandbox-template-service.api.ts b/src/api/cloud/sandbox-template-service.api.ts
new file mode 100644
--- /dev/null
+++ b/src/api/cloud/sandbox-template-service.api.ts
@@ -0,0 +1,51 @@
+import { getRegisteredBackends } from "../backend-registry/active-store";
+import { callCloudProxy } from "./proxy";
+
+export interface SandboxTemplateOption {
+  id: string;
+  display_name: string;
+}
+
+export interface SandboxSelectionOptions {
+  enabled: boolean;
+  items: SandboxTemplateOption[];
+}
+
+export async function getSandboxSelectionOptions(
+  backendId: string,
+  orgId: string,
+): Promise<SandboxSelectionOptions> {
+  const backend = getRegisteredBackends().find((item) => item.id === backendId);
+  if (backend?.kind !== "cloud") {
+    throw new Error("Sandbox templates require a registered cloud backend.");
+  }
+  const config = await callCloudProxy<{
+    feature_flags?: { enable_sandbox_selector?: boolean };
+  }>({ backend, method: "GET", path: "/api/v1/web-client/config", orgId });
+  if (config?.feature_flags?.enable_sandbox_selector !== true) {
+    return { enabled: false, items: [] };
+  }
+  const items: SandboxTemplateOption[] = [];
+  const seenPages = new Set<string>();
+  let pageId: string | null = null;
+  do {
+    const path = pageId
+      ? `/api/v1/sandbox-specs/search?page_id=${encodeURIComponent(pageId)}`
+      : "/api/v1/sandbox-specs/search";
+    const page = await callCloudProxy<{
+      items: { id: string; name?: string | null }[];
+      next_page_id?: string | null;
+    }>({ backend, method: "GET", path, orgId });
+    if (!Array.isArray(page?.items)) return { enabled: false, items: [] };
+    for (const spec of page.items) {
+      if (typeof spec?.id !== "string" || !spec.id) continue;
+      items.push({ id: spec.id, display_name: spec.name || spec.id });
+    }
+    pageId = page.next_page_id ?? null;
+    if (pageId && seenPages.has(pageId)) {
+      return { enabled: false, items: [] };
+    }
+    if (pageId) seenPages.add(pageId);
+  } while (pageId);
+  return { enabled: true, items };
+}
