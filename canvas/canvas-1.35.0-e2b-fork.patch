+export async function startCloudConversationInRuntime(
+  orgId: string,
+  sandboxId: string | null,
+  sourceConversationId?: string,
+  separateCheckout = false,
+): Promise<string> {
+  const { backend, orgId: activeOrg } = getActiveBackend();
+  if (backend.kind !== "cloud" || activeOrg !== orgId) {
+    throw new Error("The workspace organization is no longer selected.");
+  }
+  const task = await createCloudAppConversation(
+    sandboxId
+      ? {
+          sandbox_id: sandboxId,
+          ...(separateCheckout
+            ? { separate_checkout_from: sourceConversationId }
+            : { reuse_prepared_workspace_from: sourceConversationId }),
+        }
+      : { force_new_sandbox: true },
+    backend,
+  );
+  if (task.status === "ERROR") {
+    throw new Error("The conversation could not be started.");
+  }
+  return task.app_conversation_id ?? `task-${task.id}`;
+}
+
+export async function forkCloudConversationRuntime(
+  conversationId: string,
+  orgId: string,
+): Promise<{ id: string }> {
+  const { backend, orgId: activeOrg } = getActiveBackend();
+  if (backend.kind !== "cloud" || activeOrg !== orgId) {
+    throw new Error("The fork organization is no longer selected.");
+  }
+  return callCloudProxy<{ id: string }>({
+    backend,
+    method: "POST",
+    path: `/api/v1/app-conversations/${conversationId}/runtime/fork`,
+    timeoutSeconds: 185,
+  });
+}
