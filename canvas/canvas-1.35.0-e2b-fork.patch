+
+type RuntimeChoice = (typeof runtimeChoices)[number]["id"];
+
+function RuntimeConversationChoices({
+  conversationId,
+  orgId,
+  sandboxId,
+}: {
+  conversationId: string;
+  orgId: string;
+  sandboxId: string;
+}) {
+  const navigate = useNavigate();
+  const client = useQueryClient();
+  const { backend } = useActiveBackend();
+  const [pending, setPending] = React.useState<RuntimeChoice | null>(null);
+  const [error, setError] = React.useState(false);
+  const menu = React.useRef<HTMLDetailsElement>(null);
+
+  async function launch(choice: RuntimeChoice) {
+    setPending(choice);
+    setError(false);
+    try {
+      const id = choice === "fork"
+        ? (await forkCloudConversationRuntime(conversationId, orgId)).id
+        : await startCloudConversationInRuntime(
+            orgId,
+            choice === "new" ? null : sandboxId,
+            choice === "new" ? undefined : conversationId,
+            choice === "checkout",
+          );
+      const active = getActiveBackend();
+      if (active.backend.id !== backend.id || active.orgId !== orgId) return;
+      void client.invalidateQueries({ queryKey: ["user", "conversations"] });
+      if (menu.current) menu.current.open = false;
+      navigate(`/conversations/${id}`);
+    } catch {
+      setError(true);
+    } finally {
+      setPending(null);
+    }
+  }
+
+  return (
+    <details className="relative" ref={menu}>
+      <summary className="cursor-pointer list-none whitespace-nowrap rounded-md px-2 py-1 text-sm text-foreground hover:bg-contrast/10">
+        {pending ? "Starting…" : "Workspace options"}
+      </summary>
+      <div className="absolute right-0 z-30 w-64 rounded-lg border border-contrast/10 bg-background p-1 shadow-lg">
+        {runtimeChoices.map(({ id, label, description, testId }) => (
+          <button
+            key={id}
+            type="button"
+            data-testid={testId}
+            disabled={pending !== null}
+            className="block w-full rounded-md px-3 py-2 text-left text-sm text-foreground hover:bg-contrast/10 disabled:opacity-50"
+            onClick={() => void launch(id)}
+          >
+            <span className="block font-medium">{label}</span>
+            <span className="block text-xs text-muted">{description}</span>
+          </button>
+        ))}
+        {error && (
+          <p role="alert" className="px-3 py-1 text-sm">
+            Could not start the conversation.
+          </p>
+        )}
+      </div>
+    </details>
+  );
+}
 
